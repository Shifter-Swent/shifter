<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Foreground location for the automatic mission check-in; no background location. Only the
         precise location is accepted, but Android 12+ requires COARSE to be declared with FINE. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- The camera reads the QR code of an event; typing its code works without one. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Implied by the CAMERA permission: without it, devices without autofocus could not install. -->
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Android 13+ drops every notification without it; asked once on My Events (#614). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shifter"
        tools:targetApi="31">
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
        <!-- Older Play services Maps modules still use the Apache HTTP client, no longer loaded by
             default since Android 9. -->
        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />
        <!-- singleTop: a notification tapped while the app is open reaches onNewIntent, in the
             activity already shown, rather than stacking a second one (#612). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Shifter">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>