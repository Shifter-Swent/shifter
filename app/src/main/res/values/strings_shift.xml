<?xml version="1.0" encoding="utf-8"?>
<!-- Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com> -->
<resources>
    <!-- The week grid of an event's shifts, shared by the organizer's screens and the volunteer's
         application -->
    <!-- Under a day of the grid, the hours its open slots add up to, e.g. "6 h open" -->
    <string name="shift_grid_hours_open">%1$d h open</string>
    <!-- Read out for a slot, e.g. "Saturday 21 June 10:00 to 12:00, open, 3 volunteers" -->
    <string name="shift_grid_slot_description">%1$s %2$s to %3$s, %4$s</string>
    <!-- A slot the organizer has opened -->
    <string name="shift_grid_slot_open">open</string>
    <!-- A slot the organizer has not opened -->
    <string name="shift_grid_slot_closed">closed</string>
    <!-- An open slot volunteers have chosen, which the organizer can no longer close -->
    <string name="shift_grid_slot_open_locked">open, locked</string>
    <!-- An open slot the volunteer has picked -->
    <string name="shift_grid_slot_picked">picked</string>
    <!-- A slot's state followed by its volunteers, e.g. "open, 3 volunteers" -->
    <string name="shift_grid_slot_and_volunteers">%1$s, %2$s</string>
    <plurals name="shift_grid_volunteers">
        <item quantity="one">%1$d volunteer</item>
        <item quantity="other">%1$d volunteers</item>
    </plurals>
    <!-- A slot the event does not run through, which the organizer cannot open -->
    <string name="shift_grid_slot_outside_event">outside the event</string>
    <!-- The arrows that scroll the grid of an event longer than three days -->
    <string name="shift_grid_previous_day">Previous day</string>
    <string name="shift_grid_next_day">Next day</string>

    <!-- The organizer's Shifts screen, where the 2 h slots of the event are opened (#597) -->
    <string name="shifts_title">Shifts</string>
    <!-- The hours every open slot adds up to, over the days of the event, e.g. "30 h open over
         4 days" -->
    <string name="shifts_open_total">%1$d h open over %2$s</string>
    <plurals name="shifts_days">
        <item quantity="one">%1$d day</item>
        <item quantity="other">%1$d days</item>
    </plurals>
    <string name="shifts_subtitle">Volunteers pick these when they apply.</string>
    <string name="shifts_edit">Edit</string>
    <string name="shifts_done">Done</string>
    <!-- Shown while the event has no slot open -->
    <string name="shifts_empty_subtitle">Volunteers choose the shifts they can work when they
        apply.</string>
    <string name="shifts_empty_title">No shifts yet</string>
    <string name="shifts_empty_body">Tap Open slots, then the 2 h slots volunteers can pick. Until
        then, volunteers apply to a team only.</string>
    <string name="shifts_open_slots">Open slots</string>
    <!-- The shifts could not be read and none is known, so the grid has nothing to draw -->
    <string name="shifts_load_failed_title">The shifts could not be read</string>
    <string name="shifts_load_failed_body">Leave the screen and open it again to try once more.</string>
    <!-- Tapping a slot volunteers chose: "Sat 10:00 stays" over "3 volunteers chose it." -->
    <string name="shifts_kept_title">%1$s stays</string>
    <plurals name="shifts_kept_reason">
        <item quantity="one">%1$d volunteer chose it.</item>
        <item quantity="other">%1$d volunteers chose it.</item>
    </plurals>
    <!-- The one-off messages of a failure -->
    <string name="shifts_error_load">The shifts could not be read.</string>
    <string name="shifts_error_save">The slot could not be saved.</string>
    <string name="shifts_error_offline">You are offline. Open a slot once you are back online.</string>
</resources>
