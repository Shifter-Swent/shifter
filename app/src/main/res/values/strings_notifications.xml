<?xml version="1.0" encoding="utf-8"?>
<!-- Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com> -->
<!--
    The texts of the notifications, read through NotificationTexts.

    One section per NotificationKind, filled by the task that writes that kind, so the
    notification tasks of sprint 7 never edit the same lines. Inside a section, every name starts
    with the prefix of its section; a count goes in a <plurals>, never in an if on the count.
-->
<resources>

    <!-- Shared: the name of each kind's Android channel and Settings switch (#614, #620).
         Prefix: notification_channel_ -->
    <string name="notification_channel_new_application">New applications</string>
    <string name="notification_channel_new_application_description">When someone applies to one of your events.</string>
    <string name="notification_channel_application_decided">Application decisions</string>
    <string name="notification_channel_application_decided_description">When an organizer accepts or declines your application.</string>
    <string name="notification_channel_team_changed">Team changes</string>
    <string name="notification_channel_team_changed_description">When a volunteer joins or leaves one of your teams.</string>
    <string name="notification_channel_mission_assigned">Missions assigned or removed</string>
    <string name="notification_channel_mission_assigned_description">When you get a mission, by hand or from a schedule, or lose one.</string>
    <string name="notification_channel_mission_changed">Mission changes</string>
    <string name="notification_channel_mission_changed_description">When one of your missions changes time or place.</string>
    <string name="notification_channel_announcement">Announcements</string>
    <string name="notification_channel_announcement_description">Each announcement sent to a channel you are in.</string>
    <string name="notification_channel_missed_check_in">Missed check-ins</string>
    <!-- 10 min: the delay of MissedCheckIn set by #611, written here until its constant exists;
         it then goes into channelDescriptionArgs, as the window of OPEN_SPOTS does. -->
    <string name="notification_channel_missed_check_in_description">10 min after a mission starts, for each volunteer of your team who is not checked in.</string>
    <string name="notification_channel_open_spots">Missions short of volunteers</string>
    <!-- The window of OpenSpots, in hours. -->
    <string name="notification_channel_open_spots_description">Missions starting in the next %1$d h that still have open spots.</string>

    <!-- NEW_APPLICATION (#595). Prefix: notification_new_application_ -->

    <!-- APPLICATION_DECIDED (#603). Prefix: notification_application_decided_ -->

    <!-- TEAM_CHANGED (#599). Prefix: notification_team_changed_ -->

    <!-- MISSION_ASSIGNED (#617, #606). Prefix: notification_mission_assigned_ -->
    <!-- Added to one mission: its title, the short day ("Sat") and the time it starts. -->
    <string name="notification_mission_assigned_added_one">You\'re on %1$s, %2$s %3$s.</string>
    <!-- Added to several missions of the event: how many, and the event's title. -->
    <plurals name="notification_mission_assigned_added_many">
        <item quantity="one">%1$d new mission at %2$s.</item>
        <item quantity="other">%1$d new missions at %2$s.</item>
    </plurals>
    <!-- Removed from one mission: its title. -->
    <string name="notification_mission_assigned_removed_one">You were removed from %1$s.</string>
    <!-- Removed from several missions of the event: how many. -->
    <plurals name="notification_mission_assigned_removed_many">
        <item quantity="one">You were removed from %1$d mission.</item>
        <item quantity="other">You were removed from %1$d missions.</item>
    </plurals>

    <!-- MISSION_CHANGED (#617). Prefix: notification_mission_changed_ -->
    <!-- New time: the title, the short day ("Sat"), the start and the end. -->
    <string name="notification_mission_changed_time">%1$s now runs %2$s %3$s–%4$s.</string>
    <!-- New place: the title and the new address. -->
    <string name="notification_mission_changed_place">%1$s moved to %2$s.</string>
    <!-- New time and place: the title, the short day, the start, the end and the new address. -->
    <string name="notification_mission_changed_time_and_place">%1$s now runs %2$s %3$s–%4$s at %5$s.</string>
    <!-- Place removed: the title. -->
    <string name="notification_mission_changed_no_place">%1$s no longer has a place.</string>
    <!-- New time and place removed: the title, the short day, the start and the end. -->
    <string name="notification_mission_changed_time_and_no_place">%1$s now runs %2$s %3$s–%4$s and no longer has a place.</string>
    <!-- Several missions of the event changed: how many. -->
    <plurals name="notification_mission_changed_many">
        <item quantity="one">%1$d of your missions changed.</item>
        <item quantity="other">%1$d of your missions changed.</item>
    </plurals>

    <!-- ANNOUNCEMENT (#618). Prefix: notification_announcement_ -->

    <!-- MISSED_CHECK_IN (#611). Prefix: notification_missed_check_in_ -->

    <!-- OPEN_SPOTS (#608). Prefix: notification_open_spots_ -->
    <!-- The text: the mission, its start time and how many volunteers it still needs. -->
    <plurals name="notification_open_spots_text">
        <item quantity="one">%1$s at %2$s still needs %3$d volunteer.</item>
        <item quantity="other">%1$s at %2$s still needs %3$d volunteers.</item>
    </plurals>

</resources>
