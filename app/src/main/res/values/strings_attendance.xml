<?xml version="1.0" encoding="utf-8"?>
<!-- Co-authored-by: Claude Opus 5 <noreply@anthropic.com> -->
<resources>
    <!-- The manager's live attendance of the missions of their teams. These are the screen's own
         wording, not the organizer's overview_* strings: rewording one screen must not reword the
         other. -->
    <string name="attendance_subtitle_organizer">Organizer Overview</string>
    <string name="attendance_missions_title">My Missions</string>
    <plurals name="attendance_mission_count">
        <item quantity="one">%1$d mission</item>
        <item quantity="other">%1$d missions</item>
    </plurals>
    <string name="attendance_filter_all">All</string>
    <string name="attendance_team_general">General</string>
    <string name="attendance_team_unknown">Unknown team</string>
    <string name="attendance_mission_subtitle">%1$s · %2$s</string>
    <!-- Times only within a day, the day added when the mission is not on the day being read, and
         both days when it crosses midnight. -->
    <string name="attendance_schedule">%1$s–%2$s</string>
    <string name="attendance_schedule_on_day">%1$s, %2$s–%3$s</string>
    <string name="attendance_schedule_across_days">%1$s %2$s – %3$s %4$s</string>
    <string name="attendance_live_check_in">LIVE CHECK-IN</string>
    <string name="attendance_counter">%1$s/%2$d</string>
    <!-- Stands in for the present count while the attendance is not known, with what a screen
         reader says in its place. -->
    <string name="attendance_count_unknown">—</string>
    <string name="attendance_count_unknown_description">Attendance unknown, %1$d needed</string>
    <string name="attendance_understaffed">Understaffed</string>
    <string name="attendance_check_in_not_open">Check-in not open yet</string>
    <string name="attendance_check_in_open">Check-in open</string>
    <string name="attendance_completed">Completed</string>
    <string name="attendance_mark_completed">Mark as completed</string>
    <string name="attendance_mark_completed_title">Mark this mission as completed?</string>
    <string name="attendance_mark_completed_message">This can\'t be undone.</string>
    <string name="attendance_mark_completed_cancel">Cancel</string>
    <string name="attendance_mark_completed_failed">The mission could not be marked as completed.</string>
    <string name="attendance_waiting">Waiting for attendance data</string>
    <string name="attendance_unavailable">Attendance unavailable</string>
    <string name="attendance_present">PRESENT (%1$d)</string>
    <string name="attendance_expected">EXPECTED (%1$d)</string>
    <string name="attendance_missing">MISSING (%1$d)</string>
    <string name="attendance_volunteer_unknown">Unnamed volunteer</string>
    <string name="attendance_no_missions">No missions available</string>
    <string name="attendance_load_failed">Could not load the missions.</string>
    <string name="attendance_retry">Retry</string>
    <!-- Checking a missing volunteer in by hand, by tapping their name. -->
    <string name="attendance_tap_to_check_in">Tap a name to check them in</string>
    <string name="attendance_check_in_closed">Check-in is closed: the mission is completed.</string>
    <string name="attendance_check_in_action">Check in %1$s</string>
    <string name="attendance_checked_in">%1$s checked in</string>
    <string name="attendance_undo">Undo</string>
    <string name="attendance_manual">Manual</string>
    <string name="attendance_not_synced">Not synced yet</string>
    <plurals name="attendance_pending_check_ins">
        <item quantity="one">%1$d check-in is waiting for the network. Keep Shifter open.</item>
        <item quantity="other">%1$d check-ins are waiting for the network. Keep Shifter open.</item>
    </plurals>
    <string name="attendance_check_in_not_allowed">%1$s can no longer be checked in to this mission.</string>
    <string name="attendance_check_in_failed">Could not check %1$s in. Try again.</string>
    <string name="attendance_check_in_outside_window">%1$s can\'t be checked in now: check-in is open from 15 minutes before the mission until its end.</string>
    <string name="attendance_expand">Show who is present</string>
    <string name="attendance_collapse">Hide who is present</string>
    <!-- The manager's now card: is the team where it should be, now? -->
    <string name="attendance_now_needs_you">Needs you</string>
    <plurals name="attendance_now_missing">
        <item quantity="one">%1$d volunteer missing</item>
        <item quantity="other">%1$d volunteers missing</item>
    </plurals>
    <!-- Under a name: the mission they are missing from, and how late they are. -->
    <string name="attendance_now_late">%1$s · late %2$s</string>
    <string name="attendance_now_check_in">Check in</string>
    <string name="attendance_now_checked_in">Checked in</string>
    <plurals name="attendance_now_others">
        <item quantity="one">%1$d other checked in</item>
        <item quantity="other">%1$d others checked in</item>
    </plurals>
    <!-- Not being seen is not being absent: these missions are not counted as empty. -->
    <plurals name="attendance_now_unknown">
        <item quantity="one">Attendance not known for %1$d mission</item>
        <item quantity="other">Attendance not known for %1$d missions</item>
    </plurals>
    <string name="attendance_now_view_on_map">View team on map</string>
    <!-- The card before a mission starts, and at the handover once it has. -->
    <string name="attendance_now_in">%1$s in %2$s</string>
    <string name="attendance_now_starting_now">Starting now</string>
    <string name="attendance_now_started">%1$s has started</string>
    <string name="attendance_now_volunteer_arrived">Arrived</string>
    <string name="attendance_now_volunteer_expected">Expected</string>
    <!-- The card with nothing under way: what the team does next, and the day over. -->
    <string name="attendance_now_next_for_team">Next for your team</string>
    <string name="attendance_now_at_time">%1$s at %2$s</string>
    <plurals name="attendance_now_assigned">
        <item quantity="one">%1$d assigned</item>
        <item quantity="other">%1$d assigned</item>
    </plurals>
    <string name="attendance_now_done">Your team is done</string>
    <!-- The card with nobody missing: the team is at work, and another mission is coming. -->
    <string name="attendance_now_all_on_duty">All on duty</string>
    <string name="attendance_now_at_work">%1$d at work</string>
    <!-- Said instead while no mission's attendance is followed: "0 at work" would read as an
         empty team. -->
    <plurals name="attendance_now_running">
        <item quantity="one">%1$d mission running</item>
        <item quantity="other">%1$d missions running</item>
    </plurals>
    <!-- The next mission, at the foot of the card, beside its title: who is there of those it
         needs, and how many are expected when its check-in cannot have been used yet. -->
    <string name="attendance_now_arrived">%1$d of %2$d arrived</string>
    <plurals name="attendance_now_expected">
        <item quantity="one">%1$d volunteer expected</item>
        <item quantity="other">%1$d volunteers expected</item>
    </plurals>
    <plurals name="attendance_now_short_of">
        <item quantity="one">Short of %1$d volunteer</item>
        <item quantity="other">Short of %1$d volunteers</item>
    </plurals>
</resources>
