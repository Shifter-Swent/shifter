// Co-authored-by: OpenAI Codex <noreply@openai.com>
// Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
// Co-authored-by: Claude Opus 5 <noreply@anthropic.com>
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid}: a user's own profile. Created once on first sign-in.
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow read: if isOwner();

      // Location sharing is opt-in, so a profile always starts with it disabled.
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(
             ['displayName', 'email', 'locationSharingEnabled', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.locationSharingEnabled == false
        && request.resource.data.createdAt == request.time;

      // A new name is also written to the public profile in the same commit, so the two never
      // disagree.
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'locationSharingEnabled'])
        && request.resource.data.displayName is string
        && request.resource.data.locationSharingEnabled is bool
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName'])
            || getAfter(/databases/$(database)/documents/publicProfiles/$(uid)).data.displayName
                 == request.resource.data.displayName);

      allow delete: if false;
    }

    // publicProfiles/{uid}: what any signed-in user may see of a user, for now their name. Read one
    // at a time only: a uid cannot be guessed, while listing would let anyone collect every name.
    match /publicProfiles/{uid} {
      // Only the name, and the one of the private profile after the same commit.
      function matchesPrivateProfile() {
        return request.resource.data.keys().hasOnly(['displayName'])
          && request.resource.data.displayName
               == getAfter(/databases/$(database)/documents/users/$(uid)).data.displayName;
      }

      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid && matchesPrivateProfile();
      allow delete: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isOrganizer(eventId) {
      return signedIn()
        && get(/databases/$(database)/documents/events/$(eventId)).data.organizerId
           == request.auth.uid;
    }

    // Whether uid is an accepted volunteer of the event, listed in its participants document.
    function hasJoined(eventId, uid) {
      let participants = /databases/$(database)/documents/eventParticipants/$(eventId);
      return exists(participants) && uid in get(participants).data.participantIds;
    }

    function isParticipant(eventId) {
      return signedIn() && hasJoined(eventId, request.auth.uid);
    }

    // Who may see the organization of an event: its organizer and its participants.
    function canReadEventContent(eventId) {
      return isOrganizer(eventId) || isParticipant(eventId);
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.organizerId == request.auth.uid;
      allow update: if signedIn() && resource.data.organizerId == request.auth.uid
        && request.resource.data.organizerId == resource.data.organizerId;
      allow delete: if signedIn() && resource.data.organizerId == request.auth.uid;

      match /membershipRequests/{uid} {
        function isRequester() {
          return signedIn() && request.auth.uid == uid;
        }

        // Whether the volunteer is still a participant once the current commit is applied.
        function isParticipantAfter() {
          let participants = /databases/$(database)/documents/eventParticipants/$(eventId);
          return existsAfter(participants) && uid in getAfter(participants).data.participantIds;
        }

        // Whether the volunteer is a member of the team they applied to once the current commit is
        // applied. An absent memberIds field reads as an empty list, like in the app.
        function isTeamMemberAfter() {
          let team = /databases/$(database)/documents/events/$(eventId)/teams/$(resource.data.teamId);
          return existsAfter(team) && uid in getAfter(team).data.get('memberIds', []);
        }

        allow read: if isRequester() || isOrganizer(eventId);
        allow create: if isRequester()
          && exists(/databases/$(database)/documents/events/$(eventId))
          && request.resource.data.keys().hasOnly(
               ['userId', 'teamId', 'availability', 'status', 'createdAt'])
          && request.resource.data.userId == uid
          && request.resource.data.status == 'PENDING'
          // A volunteer applies to exactly one team, which must belong to the event.
          && request.resource.data.teamId is string
          && exists(/databases/$(database)/documents/events/$(eventId)/teams/$(request.resource.data.teamId))
          && request.resource.data.availability is list
          && request.resource.data.availability.size() > 0
          && request.resource.data.createdAt is timestamp;

        // Decisions must agree with participation and team membership after the same commit.
        allow update: if isOrganizer(eventId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['ACCEPTED', 'REJECTED']
          && ((request.resource.data.status == 'ACCEPTED'
                && uid in getAfter(/databases/$(database)/documents/eventParticipants/$(eventId))
                     .data.participantIds
                && isTeamMemberAfter())
              || (request.resource.data.status == 'REJECTED'
                && !(uid in getAfter(/databases/$(database)/documents/eventParticipants/$(eventId))
                       .data.participantIds)
                && !isTeamMemberAfter()));
        // A volunteer withdraws by deleting their own pending or accepted request, leaving the
        // participants and their team in the same commit. A rejected request stays, so the
        // rejection cannot be undone by applying again.
        allow delete: if isRequester()
          && (resource == null
              || (resource.data.status != 'REJECTED' && !isTeamMemberAfter()))
          && !isParticipantAfter();
      }

      // Rules do not cascade into subcollections, so teams, shifts and missions each need their
      // own block. The organizer builds them; the organizer and the participants read them, except
      // teams, which candidates read too.
      // Reads do not depend on the documents' content, so whole-subcollection queries are allowed.
      match /teams/{teamId} {
        // A volunteer who withdraws leaves their team on their own, deleting their request in the
        // same commit: a member removes only themself from memberIds, and the manager, who is not
        // among the members, only sets managerId from themself to null.
        function isWithdrawal() {
          let changed = request.resource.data.diff(resource.data).affectedKeys();
          let previous = resource.data.get('memberIds', []);
          let next = request.resource.data.get('memberIds', []);
          let leavesTheMembers = previous.removeAll(next) == [request.auth.uid]
            && next.removeAll(previous).size() == 0;
          let leavesTheManagement = resource.data.get('managerId', null) == request.auth.uid
            && request.resource.data.get('managerId', null) == null;
          // Without a change, every check below would hold, and anyone could write the team.
          return signedIn()
            && changed.size() > 0
            && changed.hasOnly(['memberIds', 'managerId'])
            && (!changed.hasAny(['memberIds']) || leavesTheMembers)
            && (!changed.hasAny(['managerId']) || leavesTheManagement)
            && !existsAfter(
                 /databases/$(database)/documents/events/$(eventId)/membershipRequests/$(request.auth.uid));
        }

        // The manager leads the members without being one of them, as TeamRepository promises.
        // Malformed memberIds are left to the mappers.
        function managerIsNotAMember() {
          let managerId = request.resource.data.get('managerId', null);
          let memberIds = request.resource.data.get('memberIds', []);
          return managerId == null || !(memberIds is list) || !(managerId in memberIds);
        }

        // A volunteer picks their team before applying, so before being a participant: any
        // signed-in user lists an event's teams. memberIds holds uids only (trade-off of #170).
        allow read: if signedIn();
        allow create, update: if isOrganizer(eventId) && managerIsNotAMember();
        allow delete: if isOrganizer(eventId);
        allow update: if isWithdrawal();

        // liveLocations/{uid}: where the volunteer uid is, shared with their manager while they
        // have location sharing on. The document id is their uid, so a volunteer shares one
        // position per team and can never write someone else's.
        match /liveLocations/{uid} {
          function team() {
            return get(/databases/$(database)/documents/events/$(eventId)/teams/$(teamId)).data;
          }

          // Sharing is opt-in, in the volunteer's own private profile; get() ignores its read rule.
          function sharingEnabled() {
            return get(/databases/$(database)/documents/users/$(uid))
              .data.get('locationSharingEnabled', false) == true;
          }

          // The position and when the GPS measured it, nothing else: the volunteer, the team and
          // the event are already in the path. measuredAt is the GPS's time, not request.time, so a
          // position sent after an offline spell is still accepted. A missing field makes the
          // expression fail, which denies the write.
          //
          // The past is therefore open, but the future is bounded, with a tolerance for a device
          // clock that runs ahead: staleness is read off this very field, so a measure dated 2099
          // would be considered fresh forever and leave the volunteer pinned at a wrong place with
          // no time limit. A wrong clock is enough for that, no forged client needed.
          function isValidLocation() {
            let data = request.resource.data;
            return data.keys().hasOnly(['position', 'measuredAt'])
              && data.measuredAt is timestamp
              && data.measuredAt <= request.time + duration.value(5, 'm')
              && data.position.keys().hasOnly(['latitude', 'longitude'])
              && data.position.latitude is number
              && data.position.latitude >= -90
              && data.position.latitude <= 90
              && data.position.longitude is number
              && data.position.longitude >= -180
              && data.position.longitude <= 180;
          }

          function isTeamManagerOrOrganizer() {
            return team().get('managerId', null) == request.auth.uid || isOrganizer(eventId);
          }

          // Positions are shared on the event day, so both publishing and reading are bounded by
          // the event's period, with an hour of margin on each side for a volunteer arriving early
          // or leaving late. Without it, a volunteer who leaves sharing on keeps publishing weeks
          // later, and the manager and the organizer keep reading it.
          //
          // It doubles as the check on the event itself: Firestore keeps a subcollection when the
          // document above it is deleted, and get() of a deleted event returns null, whose .data
          // denies the request. The manager of a deleted event's team therefore stops reading the
          // positions orphaned under it, and its members stop updating them. Only the delete below
          // is left out, so a volunteer can still take their position out afterwards.
          //
          // The period is read from the event, never from the request, and both bounds are
          // required: an event without them shares no position at all rather than for ever.
          function duringEvent() {
            let event = get(/databases/$(database)/documents/events/$(eventId)).data;
            let startAt = event.get('startAt', null);
            let endAt = event.get('endAt', null);
            return startAt is timestamp
              && endAt is timestamp
              && request.time >= startAt - duration.value(1, 'h')
              && request.time <= endAt + duration.value(1, 'h');
          }

          // An update may not move the position back in time: with two devices, a replayed write or
          // offline writes sent out of order, the manager would otherwise see the volunteer jump
          // back to where they were ten minutes ago. The same measure sent twice is still accepted,
          // so a retry is not an error.
          function isNotOlderThanStored() {
            return resource == null
              || request.resource.data.measuredAt >= resource.data.measuredAt;
          }

          // A volunteer reads back the position they shared, and only their own.
          allow get: if signedIn()
            && duringEvent()
            && (request.auth.uid == uid || isTeamManagerOrOrganizer());
          // The collection is the manager's and the organizer's, and listing it is allowed by the
          // path alone: a condition on the documents would make their query fail whenever one of
          // them did not satisfy it. Within the event's period a position therefore stays readable
          // until it is deleted, even once its volunteer turns sharing off or leaves the team; see
          // docs/firestore-schema.md for what has to delete it.
          allow list: if signedIn() && duringEvent() && isTeamManagerOrOrganizer();
          allow create, update: if signedIn()
            && duringEvent()
            && request.auth.uid == uid
            && uid in team().get('memberIds', [])
            && sharingEnabled()
            && isValidLocation()
            && isNotOlderThanStored();
          // Never refused to its owner, so they can clean up after turning sharing off, leaving the
          // team, or the event ending or being deleted, when none of the conditions above holds any
          // more.
          allow delete: if signedIn() && request.auth.uid == uid;
        }
      }

      match /shifts/{shiftId} {
        allow read: if canReadEventContent(eventId);
        allow write: if isOrganizer(eventId);
      }

      // The organizer writes every mission; a team's manager writes the missions of their team.
      match /missions/{missionId} {
        // Whether the signed-in user manages teamId. A mission of no team ("General") has no
        // manager; teamId is checked first, so get() never builds a path from null.
        function managesTeam(teamId) {
          return signedIn()
            && teamId is string
            && get(/databases/$(database)/documents/events/$(eventId)/teams/$(teamId))
                 .data.get('managerId', null) == request.auth.uid;
        }

        // A manager only adds members of the team, each once, and never more assignees than
        // needed. Those already on the mission may stay, so someone who left the team can still be
        // unassigned.
        function validAssignees(teamId, previous) {
          let next = request.resource.data.get('assigneeIds', []);
          let members =
            get(/databases/$(database)/documents/events/$(eventId)/teams/$(teamId))
              .data.get('memberIds', []);
          return next is list
            && next.size() == next.toSet().size()
            && next.size() <= request.resource.data.get('volunteersNeeded', 0)
            && next.toSet().difference(previous.toSet()).hasOnly(members);
        }

        function teamBefore() {
          return resource.data.get('teamId', null);
        }

        function teamAfter() {
          return request.resource.data.get('teamId', null);
        }

        allow read: if canReadEventContent(eventId);
        allow create: if isOrganizer(eventId)
          || (managesTeam(teamAfter()) && validAssignees(teamAfter(), []));
        // Checking the team before and after keeps a manager from moving a mission to a team they
        // do not manage.
        allow update: if isOrganizer(eventId)
          || (managesTeam(teamBefore())
              && managesTeam(teamAfter())
              && validAssignees(teamAfter(), resource.data.get('assigneeIds', [])));
        allow delete: if isOrganizer(eventId) || managesTeam(teamBefore());

        // checkIns/{uid}: the proof that volunteer uid was present at the mission. The document id
        // is their uid, so they are checked in at most once, and a check-in is never changed.
        match /checkIns/{uid} {
          function mission() {
            return get(/databases/$(database)/documents/events/$(eventId)/missions/$(missionId)).data;
          }

          // A mission of no team ("General") has no manager: only the organizer manages it.
          function isTeamManager() {
            let teamId = mission().get('teamId', null);
            return teamId != null
              && get(/databases/$(database)/documents/events/$(eventId)/teams/$(teamId))
                   .data.get('managerId', null) == request.auth.uid;
          }

          function canManage() {
            return isOrganizer(eventId) || isTeamManager();
          }

          // Checks the path, not the document, so a missing check-in can be read too.
          allow read: if signedIn() && (request.auth.uid == uid || canManage());
          // checkedInAt and checkedInBy must equal the server's time and the signed-in user, so
          // nobody can backdate a check-in or pretend someone else recorded it. A volunteer who
          // withdrew or was rejected stays in assigneeIds until unassigned, so they must also
          // still be a participant.
          allow create: if signedIn()
            && request.resource.data.keys().hasOnly(['userId', 'method', 'checkedInAt', 'checkedInBy'])
            && request.resource.data.userId == uid
            && request.resource.data.checkedInBy == request.auth.uid
            && request.resource.data.checkedInAt == request.time
            && uid in mission().get('assigneeIds', [])
            && hasJoined(eventId, uid)
            && ((request.resource.data.method == 'SELF' && request.auth.uid == uid)
                || (request.resource.data.method == 'MANAGER' && canManage()));
          allow update, delete: if false;
        }
      }
    }

    // Enables a volunteer's collection-group query filtered by userId, without granting writes.
    match /{path=**}/membershipRequests/{uid} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Enables a volunteer's collection-group query of the missions they are assigned to, filtered
    // by assigneeIds, without granting writes.
    match /{path=**}/missions/{missionId} {
      allow read: if signedIn() && request.auth.uid in resource.data.assigneeIds;
    }

    // Enables a volunteer's collection-group query of their own check-ins, filtered by userId,
    // without granting writes.
    match /{path=**}/checkIns/{uid} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /eventParticipants/{eventId} {
      function hasStatus(uid, status) {
        return uid is string
          && getAfter(/databases/$(database)/documents/events/$(eventId)/membershipRequests/$(uid))
               .data.status == status;
      }

      function validChange() {
        let previous = resource.data.participantIds;
        let next = request.resource.data.participantIds;
        let added = next.removeAll(previous);
        let removed = previous.removeAll(next);
        return next.size() == next.toSet().size()
          && added.size() + removed.size() <= 1
          && (added.size() == 0 || hasStatus(added[0], 'ACCEPTED'))
          && (removed.size() == 0 || hasStatus(removed[0], 'REJECTED'));
      }

      // Only the organizer lists the participants. isParticipant still works, because get() in
      // rules ignores them; a volunteer learns they take part from their own request.
      allow read: if isOrganizer(eventId);
      allow create: if isOrganizer(eventId)
        && request.resource.data.keys().hasOnly(['participantIds'])
        && request.resource.data.participantIds is list
        && (request.resource.data.participantIds.size() == 0
            || (request.resource.data.participantIds.size() == 1
                && hasStatus(request.resource.data.participantIds[0], 'ACCEPTED')));
      // A volunteer leaves on their own, deleting their request in the same commit.
      function isWithdrawal() {
        let previous = resource.data.participantIds;
        let next = request.resource.data.participantIds;
        return previous.removeAll(next) == [request.auth.uid]
          && next.removeAll(previous).size() == 0
          && !existsAfter(
               /databases/$(database)/documents/events/$(eventId)/membershipRequests/$(request.auth.uid));
      }

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds'])
        && request.resource.data.participantIds is list
        && ((isOrganizer(eventId) && validChange()) || isWithdrawal());
      allow delete: if false;
    }
  }
}
