// Co-authored-by: OpenAI Codex <noreply@openai.com>
// Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid}: a user's own profile. Created once on first sign-in.
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow read: if isOwner();

      // Location sharing is opt-in, so a profile always starts with it disabled.
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(
             ['displayName', 'email', 'locationSharingEnabled', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.locationSharingEnabled == false
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'locationSharingEnabled'])
        && request.resource.data.displayName is string
        && request.resource.data.locationSharingEnabled is bool;

      allow delete: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isOrganizer(eventId) {
      return signedIn()
        && get(/databases/$(database)/documents/events/$(eventId)).data.organizerId
           == request.auth.uid;
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.organizerId == request.auth.uid;
      allow update: if signedIn() && resource.data.organizerId == request.auth.uid
        && request.resource.data.organizerId == resource.data.organizerId;
      allow delete: if signedIn() && resource.data.organizerId == request.auth.uid;

      match /membershipRequests/{uid} {
        function isRequester() {
          return signedIn() && request.auth.uid == uid;
        }

        allow read: if isRequester() || isOrganizer(eventId);
        allow create: if isRequester()
          && exists(/databases/$(database)/documents/events/$(eventId))
          && request.resource.data.keys().hasOnly(
               ['userId', 'preferredTeamIds', 'availability', 'status', 'createdAt'])
          && request.resource.data.userId == uid
          && request.resource.data.status == 'PENDING'
          && request.resource.data.preferredTeamIds is list
          && request.resource.data.availability is list
          && request.resource.data.availability.size() > 0
          && request.resource.data.createdAt is timestamp;

        // Acceptance must leave the volunteer in the participants document in the same commit.
        allow update: if isOrganizer(eventId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['ACCEPTED', 'REJECTED']
          && (request.resource.data.status == 'REJECTED'
              || uid in getAfter(/databases/$(database)/documents/eventParticipants/$(eventId))
                   .data.participantIds);
        allow delete: if false;
      }
    }

    // Enables a volunteer's collection-group query filtered by userId, without granting writes.
    match /{path=**}/membershipRequests/{uid} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /eventParticipants/{eventId} {
      function accepted(uid) {
        return uid is string
          && getAfter(/databases/$(database)/documents/events/$(eventId)/membershipRequests/$(uid))
               .data.status == 'ACCEPTED';
      }

      function validAddition() {
        let previous = resource.data.participantIds;
        let next = request.resource.data.participantIds;
        let added = next.removeAll(previous);
        return next.hasAll(previous)
          && next.size() == next.toSet().size()
          && (added.size() == 0 || (added.size() == 1 && accepted(added[0])));
      }

      allow read: if signedIn();
      allow create: if isOrganizer(eventId)
        && request.resource.data.keys().hasOnly(['participantIds'])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 1
        && accepted(request.resource.data.participantIds[0]);
      allow update: if isOrganizer(eventId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds'])
        && request.resource.data.participantIds is list
        && validAddition();
      allow delete: if false;
    }
  }
}
