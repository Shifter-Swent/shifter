// Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid}: a user's own profile. Created once on first sign-in.
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow read: if isOwner();

      // Location sharing is opt-in, so a profile always starts with it disabled.
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(
             ['displayName', 'email', 'locationSharingEnabled', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.locationSharingEnabled == false
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'locationSharingEnabled'])
        && request.resource.data.displayName is string
        && request.resource.data.locationSharingEnabled is bool;

      allow delete: if false;
    }

    // events/{eventId}: signed-in users only, until per-role rules are defined.
    match /events/{eventId} {
      allow read, write: if request.auth != null;
    }
  }
}
